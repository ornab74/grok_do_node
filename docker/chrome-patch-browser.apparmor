# Derived from github.com/moby/profiles/apparmor at commit
# f9bc03ec19b2dc4c091449b08e88f85c0caa9f0b. The intentional delta is the
# userns permission required by Chromium's namespace sandbox on Ubuntu 23.10+.

abi <abi/4.0>,
include <tunables/global>

profile chrome-patch-browser flags=(attach_disconnected,mediate_deleted) {
  network,
  deny network alg,
  capability,
  file,
  umount,

  # Host/container runtime processes may stop the container.
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=rootlesskit,

  # Chromium's processes may signal and inspect only peers in this profile.
  signal (send,receive) peer=chrome-patch-browser,
  ptrace (trace,tracedby,read,readby) peer=chrome-patch-browser,

  # Narrow Ubuntu exception: this profile, not the global unconfined label,
  # may create the nested user namespace used by Chromium's sandbox.
  userns,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny mount,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
