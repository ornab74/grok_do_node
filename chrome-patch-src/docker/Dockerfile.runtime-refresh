# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Reuse the already compiled and internally hashed /opt/chromium tree plus its
# pinned Python environment. Replace only coursework, security-gate, policy,
# and application files. Dependency drift requires a reviewed source rebuild.
USER 0:0
WORKDIR /app
COPY requirements.txt /tmp/chrome-patch-requirements.txt
RUN cmp --silent /app/requirements.txt /tmp/chrome-patch-requirements.txt \
 && rm -f /tmp/chrome-patch-requirements.txt \
 && rm -rf /app \
 && install -d -m 0755 -o 10001 -g 10001 /app
COPY --chown=10001:10001 . /app
COPY docker/chromium-policy.json /etc/chromium/policies/managed/scraper.json
RUN chmod -R go-w /opt/chromium \
 && chown -R 10001:10001 /app
USER 10001:10001
ENTRYPOINT ["python", "/app/docker/entrypoint.py"]
CMD ["python", "-m", "common.sandbox_probe"]
